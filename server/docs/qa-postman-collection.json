{
  "info": {
    "name": "StaffHub Server - QA Security Checks",
    "_postman_id": "8b9e7d88-5f6f-4d43-8c2e-6c42a9f3f7f1",
    "description": "Postman collection untuk verifikasi kontrol keamanan pasca-upgrade dependency dan hardening backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    {
      "key": "allowedRedirect",
      "value": "http://localhost:5173/reset-password"
    },
    { "key": "blockedRedirect", "value": "https://evil.example/reset" },
    { "key": "testEmail", "value": "qa.user@example.com" },
    {
      "key": "adminSessionCookie",
      "value": "replace_with_admin_session_token"
    },
    {
      "key": "nonAdminSessionCookie",
      "value": "replace_with_non_admin_session_token"
    },
    {
      "key": "validSessionCookie",
      "value": "replace_with_valid_session_token"
    },
    { "key": "validRefreshToken", "value": "replace_with_valid_refresh_token" },
    { "key": "invalidRefreshToken", "value": "invalid_refresh_token" },
    { "key": "testRoleId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "stripeSignatureValid", "value": "replace_with_valid_signature" },
    { "key": "stripeSignatureInvalid", "value": "invalid_signature" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Forgot Password",
      "item": [
        {
          "name": "Allowed redirect (should pass)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"redirectTo\": \"{{allowedRedirect}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "forgot-password"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code indicates success\", function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Blocked redirect (should fail)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"redirectTo\": \"{{blockedRedirect}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "forgot-password"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Rate-limit attempt 1",
          "request": {
