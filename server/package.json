{
  "name": "staffhub-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "better-auth": "^1.4.19",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^5.1.0",
    "ioredis": "^5.8.2",
    "pg": "^8.16.3",
    "stripe": "^20.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
